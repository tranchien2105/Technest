# Copy to .env, replace both passwords, and use the same values in the URLs.
# Credentials here are placeholders, never production secrets.
POSTGRES_USER=technest
POSTGRES_PASSWORD=replace_with_random_postgres_password
POSTGRES_DB=technest_dev
REDIS_PASSWORD=replace_with_random_redis_password

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGIN=http://localhost:5173
AUTH_JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
AUTH_COOKIE_SAME_SITE=lax
LOG_LEVEL=info
DATABASE_URL=postgresql://technest:replace_with_random_postgres_password@127.0.0.1:5433/technest_dev
REDIS_URL=redis://:replace_with_random_redis_password@127.0.0.1:6380
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Transactional email: local development uses Mailpit on docker-compose ports.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Technest <no-reply@technest.local>
EMAIL_SUPPORT_EMAIL=support@technest.local
EMAIL_SUPPORT_NAME=Technest Support
FRONTEND_URL=http://localhost:5173

# Technical SEO: keep indexing disabled on development/staging.
# Set a real HTTPS origin (no path) only on the production deployment.
# SEO_SITE_URL=https://your-configured-production-domain
SEO_INDEXING_ENABLED=false
SEO_GOOGLE_VERIFICATION=
# Frontend build directory when running backend/dist/server.js outside Docker.
# STOREFRONT_DIST=/absolute/path/to/technest/dist
# Enable behind the configured public HTTPS reverse proxy.
SEO_ENFORCE_ORIGIN=false
# Set to the exact trusted proxy hop count; leave 0 for direct connections.
SEO_TRUST_PROXY_HOPS=0
