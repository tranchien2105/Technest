{
  "name": "@technest/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seeds/index.ts",
    "db:seed:large": "tsx src/database/seeds/seed-large.ts",
    "db:seed:incremental": "node --import tsx src/database/seeds/seed-incremental.ts",
    "db:seed:banners": "node --import tsx src/database/seeds/seed-incremental.ts --banners-only",
    "db:seed:verify": "node --import tsx src/database/seeds/verify-incremental.ts",
    "db:check:images": "tsx src/database/seeds/check-images.ts",
    "db:check:data": "tsx src/database/seeds/check-data-quality.ts",
    "db:seed:storefront": "node --import tsx src/database/seeds/seed-storefront.ts",
    "db:cleanup:low-quality-storefront": "node --import tsx src/database/seeds/cleanup-low-quality-storefront.ts",
    "ops:restore:rehearsal": "node scripts/rehearse-backup-restore.mjs"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.5.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "jose": "^6.2.14",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "redis": "^6.3.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
